<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compiles Worker.Core and its tests outside Unity so the simulation can be
    verified without an Editor licence and without waiting on an Editor import.
    The same test sources are also compiled by Unity's Test Framework via
    Assets/Tests/EditMode/Worker.Core.Tests.asmdef, so there is exactly one copy
    of every test.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>Worker.Core.Tests</RootNamespace>
    <AssemblyName>Worker.Core.Tests</AssemblyName>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors />
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Core/**/*.cs" />
    <Compile Include="../../Assets/Tests/EditMode/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

</Project>
