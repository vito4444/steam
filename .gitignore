# ---------------------------------------------------------------- Unity ------
game/[Ll]ibrary/
game/[Tt]emp/
game/[Oo]bj/
game/[Bb]uild/
game/[Bb]uilds/
game/[Ll]ogs/
game/[Uu]ser[Ss]ettings/
game/[Mm]emoryCaptures/
game/[Rr]ecordings/
game/Assets/AssetStoreTools*
game/Assets/Plugins/Editor/JetBrains*

# Auto-generated solution and project files
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vs/
.idea/
.vscode/

# Unity crash reports
sysinfo.txt
crashlytics-build.properties

# ------------------------------------------------------- Build artefacts -----
artifacts/
*.apk
*.aab
*.unitypackage
*.app

# -------------------------------------------------------------- Secrets ------
# Unity account credentials are supplied through the environment only and must
# never be committed.
*.env
!*.example.env
.unity_creds*
*.ulf
secrets/

# ------------------------------------------------------------- Scratch -------
*.log
.DS_Store
Thumbs.db

# --------------------------------------------------- Generated Unity assets --
# Scenes, materials, textures and pipeline assets are all generated from code by
# Monster.EditorTools.NightShiftSceneBuilder and MonsterSetup. Committing them
# would rewrite every fileID on each regeneration and bury real changes under
# thousands of lines of churn. The build regenerates them when they are absent.
game/Assets/Scenes/
game/Assets/Materials/
game/Assets/Textures/
game/Assets/Settings/

# Written by the performance test framework package at import time.
game/Assets/Resources/PerformanceTestRun*.json*
