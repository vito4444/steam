# 构建产物
/build/
/artifacts/build/

# 自动化产物：最终截图、自检报告与配平记录保留，中间过程不保留
/artifacts/logs/
/artifacts/tmp/
/artifacts/tuning/iter_*.png
/artifacts/tuning/run.log
# 演练抓帧保留最后一张作为验证证据，中间帧不入库
/artifacts/playtest/

# 崩溃报告
sysinfo.txt
crashlytics-build.properties

# 操作系统
.DS_Store
Thumbs.db
*~
