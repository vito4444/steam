# Unity
unity/*/Library/
unity/*/Temp/
unity/*/Obj/
unity/*/Build/
unity/*/Builds/
unity/*/Logs/
unity/*/UserSettings/
unity/*/MemoryCaptures/
unity/*/Recordings/
unity/*/[Aa]ssets/AssetStoreTools*
unity/*/[Aa]ssets/Plugins/Editor/JetBrains*

# Unity 生成的解决方案与工程文件
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
