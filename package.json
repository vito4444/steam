{
  "name": "pixelfit",
  "version": "0.4.6",
  "description": "PixelFit — 离线个人衣橱与搭配台（左衣橱 / 右模特）",
  "main": "out/main/index.js",
  "author": "PixelFit",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "shots": "electron-vite build && electron . --shots",
    "benchmark:tryon": "vite-node scripts/benchmark-cloud-tryon.ts",
    "evidence:ai": "vite-node --script scripts/cere26-ai-evidence.ts",
    "evidence:triptychs": "electron-vite build && vite-node --script scripts/cere26-triptychs.ts",
    "figures": "electron-vite build && electron . --figures",
    "dist": "electron-vite build && electron-builder --win nsis portable",
    "blockmap:diff": "vite-node --script scripts/blockmap-diff.ts",
    "check:layout": "esbuild scripts/layout_check.ts --bundle --platform=node --format=esm --alias:@shared=./src/shared --alias:@=./src/renderer/src --outfile=scripts/.layout_check.mjs --log-level=warning && node scripts/.layout_check.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
